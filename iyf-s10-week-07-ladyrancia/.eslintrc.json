{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "eqeqeq": "error",
        "curly": "error",
        "prefer-const": "warn",
        "no-var": "error",
        "semi": ["error", "always"],
        "quotes": ["warn", "single"],
        "indent": ["warn", 4],
        "no-multiple-empty-lines": "warn"
    }
}
